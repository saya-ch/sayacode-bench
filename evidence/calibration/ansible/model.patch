+def get_cache_id(url):
+    """ Return a cache identifier for ``url`` based on the server it points at.
+
+    The identifier is built from the hostname and the port only, any path, query
+    string or credentials embedded in the URL are not part of it:
+
+        https://galaxy.ansible.com/api/ -> galaxy.ansible.com:
+        https://user:pass@server.com:8080/api/ -> server.com:8080
+
+    The port is an empty string when the URL doesn't specify one, or when the
+    port isn't a valid integer.
+
+    :param url: The URL to build the cache identifier for.
+    :return: The cache identifier as a text string.
+    """
+    url_info = urlparse(to_native(url, errors='surrogate_or_strict'))
+
+    try:
+        port = int(url_info.port)
+    except (TypeError, ValueError):
+        port = ''
+
+    return to_native("%s:%s" % (url_info.hostname, port))
+
